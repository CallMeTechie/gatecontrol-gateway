# Gepinnte Bausteine des Raspberry-Pi-Images (von rpi/build-image.sh und
# rpi/stage-gatecontrol/ gelesen). Beim Anheben IMMER Commit/Digest/
# Fingerprint mitziehen – der Bau bricht ab, wenn etwas nicht passt.

# pi-gen (offizielles Build-Werkzeug von Raspberry Pi OS), Branch arm64.
# Tag 2026-10-06-raspios-trixie-arm64 = Basis von Raspberry Pi OS Lite
# (64 bit, Debian 13 "trixie") vom 06.10.2026.
PI_GEN_REPO=https://github.com/RPi-Distro/pi-gen.git
PI_GEN_TAG=2026-10-06-raspios-trixie-arm64
PI_GEN_COMMIT=b2cd98a9ee08a31ef7d0110ed09f2492bbd972ec

# Docker-Apt-Repository. Der Signaturschlüssel liegt im Repo
# (stage-gatecontrol/00-docker/files/docker.asc, Stand 2026-11, ohne Ablauf-
# datum) und wird beim Bau gegen Fingerprint UND SHA-256 geprüft.
DOCKER_APT_URL=https://download.docker.com/linux/debian
DOCKER_GPG_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
DOCKER_GPG_SHA256=1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570

# deCONZ (Phoscon) für RaspBee II / ConBee – Tag + Multi-Arch-Digest.
DECONZ_IMAGE=deconzcommunity/deconz:2.33.2@sha256:3defae1287ecc1a73b68279e12579a5a5e997a83f4ff785fe4bc30f21faf8015

# Build-Umgebung für pi-gen in CI (Debian trixie arm64, nativ auf dem
# arm64-Runner; pi-gen unterstützt nur Debian-Hosts und native Builds).
BUILD_CONTAINER=debian:trixie-20261027@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1
