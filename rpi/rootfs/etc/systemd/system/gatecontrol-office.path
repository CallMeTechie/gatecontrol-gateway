[Unit]
Description=GateControl Gateway: Dienst office auf Wunsch des Gateways anlegen
Documentation=https://github.com/CallMeTechie/gatecontrol-gateway/blob/main/docs/print.md

[Path]
PathExists=/opt/gatecontrol-gateway/gateway-state/office-start
Unit=gatecontrol-office.service

[Install]
WantedBy=multi-user.target
