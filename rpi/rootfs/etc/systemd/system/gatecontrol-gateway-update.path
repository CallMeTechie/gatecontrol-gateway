[Unit]
Description=GateControl Gateway: auf Update-Anforderung des Servers warten
Documentation=https://github.com/CallMeTechie/gatecontrol-gateway/blob/main/docs/auto-update.md

[Path]
PathExists=/opt/gatecontrol-gateway/gateway-state/pending-update
Unit=gatecontrol-gateway-update.service

[Install]
WantedBy=multi-user.target
