[Unit]
Description=GateControl Gateway: deCONZ-Dienst auf Wunsch des Gateways anlegen
Documentation=https://github.com/CallMeTechie/gatecontrol-gateway/blob/main/docs/radio.md

[Path]
PathExists=/opt/gatecontrol-gateway/gateway-state/radio-start
Unit=gatecontrol-radio.service

[Install]
WantedBy=multi-user.target
