#!/bin/bash
# GateControl Gateway (Raspberry-Pi-Image) — deCONZ-Dienst auf Wunsch des
# Gateways anlegen (docs/radio.md).
#
# Wird Zigbee in GateControl eingeschaltet, während der deCONZ-Container nicht
# läuft (beim Start war kein Funkmodul da), legt der Gateway-Container
# gateway-state/radio-start an. gatecontrol-radio.path startet dann dieses
# Skript: Flag entfernen, `docker compose up -d deconz` (beim ersten Mal mit
# Image-Download). Ein- und ausgeschaltet wird danach allein über die
# Steuerdatei des Gateways (radio-ctl/zigbee.env) – hier passiert nichts weiter.
set -euo pipefail

# shellcheck source-path=SCRIPTDIR source=../lib/gatecontrol/common.sh
. "${GC_LIB:-/usr/local/lib/gatecontrol}/common.sh"

FLAG="$GC_DIR/gateway-state/radio-start"

main() {
  [ "$(id -u)" = 0 ] || { echo "Bitte als root ausführen" >&2; exit 1; }
  [ -e "$FLAG" ] || exit 0
  # zuerst verbrauchen: ein neuer Wunsch des Gateways legt das Flag neu an
  rm -f -- "$FLAG"
  [ -s "$GC_DIR/config/gateway.env" ] || exit 0
  install -d -m 0755 "$GC_DIR/deconz"
  local args=(-f docker-compose.yml)
  [ -f "$GC_DIR/docker-compose.rollback.yml" ] && args+=(-f docker-compose.rollback.yml)
  gc_log "Zigbee in GateControl eingeschaltet — deCONZ-Dienst wird angelegt"
  (cd "$GC_DIR" && docker compose "${args[@]}" up -d --no-deps deconz)
}

main "$@"
