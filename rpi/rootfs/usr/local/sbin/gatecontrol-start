#!/bin/bash
# GateControl Gateway (Raspberry-Pi-Image) — Erststart und Start des Stacks.
#
# Läuft bei jedem Boot (gatecontrol-gateway.service) und kann jederzeit von
# Hand wiederholt werden:  sudo gatecontrol-start
#
#  1. Liegt eine gateway.env (oder gateway-<id>.env) auf der Boot-Partition
#     (/boot/firmware/gatecontrol/ oder direkt /boot/firmware/), wird sie
#     geprüft, nach /opt/gatecontrol-gateway/config/gateway.env übernommen
#     (0600 root) und von der FAT-Partition gelöscht. So funktioniert auch
#     eine Neu-Einrichtung: neue Datei auf die SD-Karte, Pi starten.
#  2. Ohne gateway.env: nur der Dienst gateway startet und zeigt seine
#     Einrichtungsseite (docs/setup-page.md) unter http://<hostname>.local
#     (Port 80) und http://<adresse>:8642 — dort Serveradresse und
#     Einrichtungscode aus GateControl eingeben. Der Pi heißt dafür
#     „gatecontrol“, solange kein anderer Name gesetzt ist. Hinweis in Journal,
#     Konsole, Login und STATUS.txt. Hat die Seite die gateway.env geschrieben,
#     startet gatecontrol-setup.path dieses Skript erneut (übrige Dienste).
#  3. Hostname setzen (settings.txt HOSTNAME → GC_HOSTNAME in der env →
#     Name aus dem Raspberry Pi Imager bleibt → gc-<Peer-Name>).
#  4. Dienste wählen: gateway, edge + mqtt (settings.txt EDGE=on|off, Standard on),
#     deconz, wenn Zigbee in GateControl eingeschaltet ist (gateway-state/radio.json,
#     vom Gateway geschrieben) oder – solange GateControl nichts entschieden hat –
#     gatecontrol-hwdetect ein Funkmodul erkannt hat; docker compose up.
#     Ein/aus und das Gerät bestimmt danach das Gateway (docs/radio.md).
#     ki (lokale KI, docs/local-ai.md), wenn sie in GateControl eingeschaltet ist
#     (gateway-state/ai.json, vom Gateway geschrieben).
#     kameras (Kameras im Heimnetz, docs/cameras.md), wenn sie in GateControl
#     eingeschaltet sind (gateway-state/cameras.json, vom Gateway geschrieben).
#     office (Office-Dateien drucken, docs/print.md), wenn es in GateControl
#     eingeschaltet ist (gateway-state/office.json, vom Gateway geschrieben).
set -euo pipefail

# shellcheck source-path=SCRIPTDIR source=../lib/gatecontrol/common.sh
. "${GC_LIB:-/usr/local/lib/gatecontrol}/common.sh"

CONFIG_DIR="$GC_DIR/config"
ENV_FILE="$CONFIG_DIR/gateway.env"
ROLLBACK="$GC_DIR/docker-compose.rollback.yml"

# Alle gateway*.env auf der Boot-Partition, neueste zuerst.
boot_env_files() {
  local d
  for d in "$GC_BOOT_DIR" "$GC_BOOT"; do
    [ -d "$d" ] || continue
    find "$d" -maxdepth 1 -type f -iname 'gateway*.env' -printf '%T@ %p\n' 2>/dev/null
  done | sort -rn | cut -d' ' -f2-
}

valid_env() {
  grep -qE '^GC_SERVER_URL=https?://[^[:space:]]+$' "$1" \
    && grep -qE '^GC_API_TOKEN=gc_gw_[a-f0-9]{64}$' "$1" \
    && grep -qE '^GC_GATEWAY_TOKEN=[a-f0-9]{64}$' "$1" \
    && grep -qE '^GC_TUNNEL_IP=[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' "$1" \
    && grep -qE '^WG_PRIVATE_KEY=.+' "$1" \
    && grep -qE '^WG_ENDPOINT=.+' "$1"
}

# Rückgabe: 0 = neue env übernommen, 1 = keine gefunden, 2 = ungültig
import_env() {
  local src tmp rc=0
  src="$(boot_env_files | head -n1)"
  [ -n "$src" ] || return 1

  install -d -m 0700 -o root -g root "$CONFIG_DIR"
  tmp="$(mktemp "$CONFIG_DIR/.gateway.env.XXXXXX")"   # mktemp legt 0600 an
  # Windows-Zeilenenden und UTF-8-BOM entfernen (Editor auf dem PC)
  tr -d '\r' <"$src" | sed '1s/^\xEF\xBB\xBF//' >"$tmp"

  if valid_env "$tmp"; then
    mv -f "$tmp" "$ENV_FILE"
    gc_log "gateway.env von der Boot-Partition übernommen ($(basename "$src"))"
  else
    mv -f "$tmp" "$ENV_FILE.rejected"
    gc_log "FEHLER: $(basename "$src") ist keine gültige GateControl-gateway.env (abgelegt unter $ENV_FILE.rejected)"
    rc=2
  fi
  chown root:root "$CONFIG_DIR"/gateway.env* 2>/dev/null || true
  chmod 0600 "$CONFIG_DIR"/gateway.env* 2>/dev/null || true

  # Geheimnisse nicht auf der (unverschlüsselten, am PC lesbaren) FAT-
  # Partition liegen lassen — auch ältere Kopien entfernen.
  boot_env_files | while IFS= read -r f; do rm -f -- "$f"; done
  sync -f "$GC_BOOT" 2>/dev/null || sync
  return "$rc"
}

sanitize_hostname() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' \
    | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-63 | sed 's/-$//'
}

apply_hostname() {
  local want explicit=0 cur peer
  want="$(gc_setting HOSTNAME)"
  [ -n "$want" ] || want="$(gc_env_value "$ENV_FILE" GC_HOSTNAME)"
  [ -n "$want" ] && explicit=1
  cur="$(hostname)"
  if [ "$explicit" = 0 ]; then
    # Im Imager gesetzter Name hat Vorrang vor dem Automatik-Namen.
    # ("gatecontrol" = Name der Einrichtungsseite, gilt wie kein Name.)
    [ "$cur" = "raspberrypi" ] || [ "$cur" = "localhost" ] || [ "$cur" = "$SETUP_HOSTNAME" ] || return 0
    # Direkt nach dem Verbinden über die Einrichtungsseite bleibt der Name
    # (der Browser steht noch auf http://gatecontrol.local); umbenannt wird beim nächsten Start.
    [ "${GC_SETUP_RUN:-0}" = 1 ] && return 0
    peer="$(sed -n 's/^# Peer: \(.*\) (ID: [0-9]*)$/\1/p' "$ENV_FILE" | head -n1)"
    peer="$(sanitize_hostname "$peer")"
    if [ -n "$peer" ]; then want="gc-$peer"; else want="gatecontrol-gw"; fi
  fi
  want="$(sanitize_hostname "$want" | cut -c1-63)"
  [ -n "$want" ] || return 0
  [ "$want" = "$cur" ] && return 0

  if ! hostnamectl set-hostname "$want" 2>/dev/null; then
    printf '%s\n' "$want" >"$GC_ETC/hostname"
    hostname "$want"
  fi
  if grep -q '^127\.0\.1\.1' "$GC_ETC/hosts"; then
    sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$want/" "$GC_ETC/hosts"
  else
    printf '127.0.1.1\t%s\n' "$want" >>"$GC_ETC/hosts"
  fi
  # cloud-init soll den Namen bei späteren Starts nicht zurücksetzen.
  if [ -d "$GC_ETC/cloud/cloud.cfg.d" ]; then
    printf '# GateControl: Hostname wird von gatecontrol-start verwaltet\npreserve_hostname: true\n' \
      >"$GC_ETC/cloud/cloud.cfg.d/99-gatecontrol-hostname.cfg"
  fi
  systemctl try-restart avahi-daemon.service >/dev/null 2>&1 || true
  gc_log "Hostname gesetzt: $want"
}

write_compose_env() {
  local dev="" type="" tz="" cache="" tmp
  if [ -r "$GC_RUN/zigbee.env" ]; then
    dev="$(gc_env_value "$GC_RUN/zigbee.env" GC_ZIGBEE_DEVICE)"
    type="$(gc_env_value "$GC_RUN/zigbee.env" GC_ZIGBEE_TYPE)"
  fi
  [[ "$dev" =~ ^/dev/[A-Za-z0-9/_.:-]+$ ]] || dev=""
  tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  [[ "$tz" =~ ^[A-Za-z0-9/_+-]{1,64}$ ]] || tz=""
  # Zwischenspeicher auf einem eigenen Datenträger (USB-Platte, per fstab
  # eingehängt) statt auf der SD-Karte: CACHE_DIR in settings.txt.
  cache="$(gc_setting CACHE_DIR '')"
  if [ -n "$cache" ]; then
    if [[ "$cache" =~ ^/[A-Za-z0-9/_.@+-]{1,200}$ ]] && [[ "$cache" != *..* ]] && [ -d "$cache" ]; then
      gc_log "Zwischenspeicher: $cache"
    else
      gc_log "CACHE_DIR=$cache ungültig oder kein Ordner — Zwischenspeicher bleibt in $GC_DIR/gateway-cache"
      cache=""
    fi
  fi
  tmp="$(mktemp "$GC_DIR/.env.XXXXXX")"
  {
    echo "# Automatisch geschrieben von gatecontrol-start — Änderungen gehen beim nächsten Start verloren."
    echo "# Zigbee an/aus: in GateControl (Gateway › Funk)"
    if [ -n "$tz" ]; then echo "TZ=$tz"; fi
    if [ -n "$cache" ]; then echo "GC_CACHE_DIR=$cache"; fi
  } >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$GC_DIR/.env"
  ZIGBEE_DEVICE="$dev"
  ZIGBEE_TYPE="$type"
}

# Einrichtungsseite: ohne eigenen Namen ist der Pi unter gatecontrol.local erreichbar.
setup_hostname() {
  local cur
  [ -n "$(gc_setting HOSTNAME)" ] && return 0
  cur="$(hostname)"
  [ "$cur" = "raspberrypi" ] || [ "$cur" = "localhost" ] || return 0
  if ! hostnamectl set-hostname "$SETUP_HOSTNAME" 2>/dev/null; then
    printf '%s\n' "$SETUP_HOSTNAME" >"$GC_ETC/hostname"
    hostname "$SETUP_HOSTNAME"
  fi
  if grep -q '^127\.0\.1\.1' "$GC_ETC/hosts"; then
    sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$SETUP_HOSTNAME/" "$GC_ETC/hosts"
  else
    printf '127.0.1.1\t%s\n' "$SETUP_HOSTNAME" >>"$GC_ETC/hosts"
  fi
  systemctl try-restart avahi-daemon.service >/dev/null 2>&1 || true
}

# Zigbee gewünscht? gateway-state/radio.json (vom Gateway, {"zigbee":…,"want":…})
# entscheidet; ohne Datei (erster Start, älteres Gateway) zählt die Erkennung.
zigbee_wanted() {
  local f="$GC_DIR/gateway-state/radio.json"
  if [ -r "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 99999)" -lt 4096 ]; then
    if grep -q '"want":true' "$f"; then return 0; fi
    if grep -q '"want":false' "$f"; then return 1; fi
  fi
  [ -n "$ZIGBEE_DEVICE" ]
}

# zigbee2mqtt / Thread gewünscht? gateway-state/radio.json ({"z2m":true,"thread":true}); ohne Datei: nein.
radio_flag() {
  local f="$GC_DIR/gateway-state/radio.json"
  [ -r "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 99999)" -lt 4096 ] && grep -q "\"$1\":true" "$f"
}

# Lokale KI gewünscht? gateway-state/ai.json (vom Gateway, {"want":…}); ohne Datei: nein.
ai_wanted() {
  local f="$GC_DIR/gateway-state/ai.json"
  [ -r "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 99999)" -lt 4096 ] && grep -q '"want":true' "$f"
}

# Kameras gewünscht? gateway-state/cameras.json (vom Gateway, {"want":…}); ohne Datei: nein.
cameras_wanted() {
  local f="$GC_DIR/gateway-state/cameras.json"
  [ -r "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 99999)" -lt 4096 ] && grep -q '"want":true' "$f"
}

# Office-Dateien drucken (docs/print.md): Wunsch des Gateways (features.print.office)
office_wanted() {
  local f="$GC_DIR/gateway-state/office.json"
  [ -r "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 99999)" -lt 4096 ] && grep -q '"want":true' "$f"
}

compose() {
  local args=(-f docker-compose.yml)
  # Hat update.sh nach einem fehlgeschlagenen Update auf das alte Image
  # zurückgerollt, muss der Start dabei bleiben (sonst käme das kaputte
  # :latest wieder hoch).
  [ -f "$ROLLBACK" ] && args+=(-f "$(basename "$ROLLBACK")")
  (cd "$GC_DIR" && docker compose "${args[@]}" "$@")
}

main() {
  [ "$(id -u)" = 0 ] || { echo "Bitte als root ausführen (sudo gatecontrol-start)" >&2; exit 1; }
  install -d -m 0755 "$GC_RUN" "$GC_DIR/gateway-state" "$GC_DIR/gateway-cache" "$GC_DIR/deconz"
  install -d -m 0700 -o root -g root "$CONFIG_DIR"

  local imported=0 rc=0
  import_env || rc=$?
  [ "$rc" = 0 ] && imported=1

  if [ ! -s "$ENV_FILE" ]; then
    # Einrichtungsseite des Gateways (docs/setup-page.md): nur der Dienst
    # gateway, er wartet auf Serveradresse und Einrichtungscode.
    setup_hostname
    write_compose_env
    compose up -d gateway
    local url
    url="http://$(hostname).local"
    if [ "$rc" = 2 ]; then
      gc_status "FEHLER" "Die gateway.env auf der SD-Karte war ungültig. Im Browser im Heimnetz $url öffnen und Serveradresse und Einrichtungscode aus GateControl eingeben – oder die Datei in GateControl neu herunterladen, nach 'bootfs/gatecontrol/' kopieren und den Pi neu starten."
    else
      gc_status "WARTET AUF EINRICHTUNG" "Im Browser im Heimnetz $url öffnen und Serveradresse und Einrichtungscode aus GateControl eingeben (Gateways > Gateway hinzufügen). Wie bisher geht auch: gateway.env aus GateControl auf die SD-Karte (Laufwerk 'bootfs', Ordner 'gatecontrol') kopieren und den Pi neu starten."
    fi
    exit 0
  fi

  apply_hostname
  write_compose_env

  local svc=(gateway) edge
  # Edge-Container (Plugin-Teile, docs/edge.md): Standard an — er bleibt
  # untätig, bis der Server Edge für dieses Gateway einschaltet.
  edge="$(gc_setting EDGE on | tr '[:upper:]' '[:lower:]')"
  if [ "$edge" = off ]; then
    compose rm -s -f "${EDGE_SERVICES[@]}" >/dev/null 2>&1 || true
  else
    svc+=("${EDGE_SERVICES[@]}")
  fi
  local zigbee=0
  if zigbee_wanted; then
    zigbee=1
    if [ -n "$ZIGBEE_DEVICE" ]; then
      gc_log "Zigbee: ${ZIGBEE_TYPE:-?} an $ZIGBEE_DEVICE — deCONZ wird gestartet (Phoscon: http://$(hostname).local:8090)"
    else
      gc_log "Zigbee in GateControl eingeschaltet — deCONZ-Dienst wartet auf ein Funkmodul"
    fi
    svc+=(deconz)
  else
    # deCONZ eines früheren Starts entfernen (Modul abgezogen / in GateControl aus)
    compose rm -s -f deconz >/dev/null 2>&1 || true
  fi
  # zigbee2mqtt und Thread Border Router (docs/radio.md): nur wenn in GateControl gewählt
  local s
  for s in z2m:zigbee2mqtt thread:otbr; do
    if radio_flag "${s%%:*}"; then
      gc_log "Funk: Dienst ${s##*:} wird gestartet (in GateControl eingeschaltet)"
      svc+=("${s##*:}")
    else
      compose rm -s -f "${s##*:}" >/dev/null 2>&1 || true
    fi
  done
  local ai=0
  if ai_wanted; then
    ai=1
    gc_log "Lokale KI in GateControl eingeschaltet — Dienst ki wird gestartet"
    svc+=(ki)
  else
    # ki eines früheren Starts entfernen (in GateControl aus; die Modelle bleiben im Volume)
    compose rm -s -f ki >/dev/null 2>&1 || true
  fi
  local cams=0
  if cameras_wanted; then
    cams=1
    gc_log "Kameras in GateControl eingeschaltet — Dienst kameras wird gestartet"
    svc+=(kameras)
  else
    # kameras eines früheren Starts entfernen (in GateControl aus; die Clips bleiben im Volume)
    compose rm -s -f kameras >/dev/null 2>&1 || true
  fi
  local office=0
  if office_wanted; then
    office=1
    gc_log "Office-Dateien drucken in GateControl eingeschaltet — Dienst office wird gestartet"
    svc+=(office)
  else
    # office eines früheren Starts entfernen (in GateControl aus)
    compose rm -s -f office >/dev/null 2>&1 || true
  fi
  compose up -d --remove-orphans "${svc[@]}"
  if [ "$imported" = 1 ]; then
    compose up -d --force-recreate gateway
  fi

  local msg
  msg="Gateway läuft (Hostname $(hostname))."
  [ "$zigbee" = 1 ] && msg="$msg deCONZ/Phoscon: Port 8090."
  [ "$ai" = 1 ] && msg="$msg Lokale KI: an."
  [ "$cams" = 1 ] && msg="$msg Kameras: an."
  [ "$office" = 1 ] && msg="$msg Office-Dateien drucken: an."
  [ "$rc" = 2 ] && msg="$msg ACHTUNG: eine neue gateway.env war ungültig, die bisherige wird weiter verwendet."
  gc_status "OK" "$msg"
}

ZIGBEE_DEVICE=""
ZIGBEE_TYPE=""
SETUP_HOSTNAME="gatecontrol"
EDGE_SERVICES=(edge mqtt)
main "$@"
