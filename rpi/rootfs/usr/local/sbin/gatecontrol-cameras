#!/bin/bash
# GateControl Gateway (Raspberry-Pi-Image) — Dienst kameras (Kameras im
# Heimnetz) auf Wunsch des Gateways anlegen (docs/cameras.md).
#
# Werden Kameras in GateControl eingeschaltet, während der Container kameras
# nicht läuft, legt der Gateway-Container gateway-state/cameras-start an.
# gatecontrol-cameras.path startet dann dieses Skript: Flag entfernen,
# `docker compose up -d kameras` (beim ersten Mal mit Image-Download). Was
# aufgenommen wird, steuert danach allein das Gateway (cam-ctl/run/*.env).
set -euo pipefail

# shellcheck source-path=SCRIPTDIR source=../lib/gatecontrol/common.sh
. "${GC_LIB:-/usr/local/lib/gatecontrol}/common.sh"

FLAG="$GC_DIR/gateway-state/cameras-start"

main() {
  [ "$(id -u)" = 0 ] || { echo "Bitte als root ausführen" >&2; exit 1; }
  [ -e "$FLAG" ] || exit 0
  # zuerst verbrauchen: ein neuer Wunsch des Gateways legt das Flag neu an
  rm -f -- "$FLAG"
  [ -s "$GC_DIR/config/gateway.env" ] || exit 0
  local args=(-f docker-compose.yml)
  [ -f "$GC_DIR/docker-compose.rollback.yml" ] && args+=(-f docker-compose.rollback.yml)
  gc_log "Kameras in GateControl eingeschaltet — Dienst kameras wird angelegt"
  (cd "$GC_DIR" && docker compose "${args[@]}" up -d --no-deps kameras)
}

main "$@"
